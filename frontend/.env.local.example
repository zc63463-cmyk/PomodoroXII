# PomodoroXII Frontend — API / platform env

# Backend origin — this is what actually matters (2026-09-02 修正).
# next.config.ts 的 rewrite 读的是 TASK_SPACE_API_TARGET，不是下面那个
# NEXT_PUBLIC_API_BASE。此前本文件只写了后者并声称"browser calls use the
# rewrite"，导致按此配置的人前端永远打不通后端（rewrite 落到默认 8000）。
TASK_SPACE_API_TARGET=http://127.0.0.1:8000

# 仅作文档/展示用途，rewrite 并不读它。保留以兼容可能引用它的文档。
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# REST paths in code use `/api/v1` (see src/lib/platform.ts API_V1_PREFIX).
# 实际转发规则：  /api/:path*  →  ${TASK_SPACE_API_TARGET}/api/:path*
# 默认 8000；若该端口被占用（本机 Docker Postgres / 其它代理常见于 8000），
# 改 TASK_SPACE_API_TARGET 指向后端真实端口即可。
#
# 注意：TASK_SPACE_API_TARGET 由 next.config.ts 读取，
# 改动后必须**重启** dev server —— env 热重载对它不生效。

# 本机核对转发是否通（注意 --noproxy，本机常设有 HTTP_PROXY 会干扰）：
#   curl -s --noproxy '*' http://127.0.0.1:<前端端口>/api/v1/auth/verify
# 期望：HTTP 401 + {"detail":"Missing or invalid Authorization header"}
# 若返回 500，说明 rewrite 目标不可达，检查该变量与后端端口。

# Local-only shortcut for reviewing the Quick Notes UI without backend auth.
# Production builds ignore this unless explicitly set.
# NEXT_PUBLIC_QUICK_NOTES_PREVIEW=1
